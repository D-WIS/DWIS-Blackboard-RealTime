<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The SignalR client of the hub role (specification section 6, decision D-63): Core's IHubConnection over the old DWIS hub, MessagePack and the old DTOs, so that Core takes no SignalR dependency.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../DWIS.RealTime.Core/DWIS.RealTime.Core.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
